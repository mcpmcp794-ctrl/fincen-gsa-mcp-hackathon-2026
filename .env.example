# Copy to .env for local development. Never commit the filled-in .env.

# Transport: stdio locally; HTTP is chosen automatically on Databricks Apps.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Databricks SQL warehouse (local dev). In Databricks Apps these come from resources.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

CARD_TRANSACTION_TABLE=workspace.default.card_transaction_mcp_clean
LLM_ENDPOINT=models.ai.gpt-5-6-luna

# Evaluation only (aggregate metrics against the restricted label table).
ENABLE_EVALUATION_TOOLS=false
EVALUATION_LABEL_TABLE=workspace.default.card_transaction_mcp_evaluation_labels
